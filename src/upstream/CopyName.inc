// Native folder class/GetName substitute the panel property boundary; its GetProperty is non-const.
UString PortAgentFolder::GetItemName_for_Copy(unsigned itemIndex)
{
  if (itemIndex == kParentIndex)
    return L"..";
  UString s;
  {
    NCOM::CPropVariant prop;
    if (GetProperty(itemIndex, kpidOutName, &prop) == S_OK)
    {
      if (prop.vt == VT_BSTR)
        s = prop.bstrVal;
      else if (prop.vt != VT_EMPTY)
        throw 2723401;
    }
    if (s.IsEmpty())
      s = GetName(itemIndex);
  }
  return Get_Correct_FsFile_Name(s);
}
